NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://user:password@localhost:5432/app_dev
# STAGE3_ENABLE_POSTGRES=true
# Phase 2 -- required to call /internal/wallet/* (credit/debit). Never give
# this to a mobile client; it is checked against the x-wallet-service-key
# header by src/routes/wallet.internal-routes.js.
# WALLET_INTERNAL_KEY=replace-with-a-real-random-secret
# LOG_DRAIN_URL=https://in.logs.betterstack.com/YOUR_SOURCE_TOKEN

# Agora Voice/RTC -- required to call POST /platform/api/rtc/token
# AGORA_APP_ID is not secret by itself but is still only ever served to an
# authenticated session -- never put it in Mobile source or a public repo README.
# AGORA_APP_ID=your-agora-app-id
#
# AGORA_APP_CERTIFICATE is a SERVER SECRET. Set it directly on the real
# Backend host's env/secrets panel (or a local .env kept out of git).
# NEVER commit it, log it, put it in Mobile code, or paste it into a chat/AI tool.
# AGORA_APP_CERTIFICATE=replace-with-the-real-app-certificate
#
# Optional, defaults to 3600 (1h). Clamped server-side to 60-86400 regardless
# of what is set here.
# AGORA_RTC_TOKEN_TTL_SECONDS=3600

# Recharge provider verification (Phase 5) -- required to call
# POST /platform/api/recharge/orders/:orderId/complete. Without these,
# that endpoint correctly returns 503 and credits nothing (fail-closed,
# same pattern as AUTH's SMS/OAuth providers) -- it never fakes a
# verified purchase. Real Google Play / App Store SDK integration is
# separate future work (see PHASE5_CENTRAL_SYSTEMS_REPORT.md); these vars
# point at an already-real HTTP verification endpoint if one exists.
# RECHARGE_GOOGLE_PLAY_VERIFY_URL=https://your-verification-service/verify/google-play
# RECHARGE_APP_STORE_VERIFY_URL=https://your-verification-service/verify/app-store
