NODE_ENV=staging
PORT=3000
LOG_LEVEL=info
STAGE3_ENABLE_POSTGRES=true
DATABASE_URL=postgres://staging_user:REPLACE_ME@staging-db-host:5432/app_staging
# LOG_DRAIN_URL is set as a secret in the CI/CD provider, not committed here.

# Agora Voice/RTC. AGORA_APP_ID is not secret; confirm with the team whether
# staging uses the same Agora project as production or a separate one.
AGORA_APP_ID=782b5a107daf4ced943efdbc997bb2c7
AGORA_RTC_TOKEN_TTL_SECONDS=3600
# AGORA_APP_CERTIFICATE is a SERVER SECRET -- set it in the CI/CD provider's
# secrets panel, not committed here.
