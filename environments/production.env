NODE_ENV=production
PORT=3000
LOG_LEVEL=warn
STAGE3_ENABLE_POSTGRES=true
DATABASE_URL=postgres://prod_user:REPLACE_ME@prod-db-host:5432/app_prod
# LOG_DRAIN_URL is set as a secret in the CI/CD provider, not committed here.
# Production deploys are NOT wired to auto-deploy in Stage 1 — manual promotion only.

# Agora Voice/RTC. AGORA_APP_ID is not secret by itself.
AGORA_APP_ID=782b5a107daf4ced943efdbc997bb2c7
AGORA_RTC_TOKEN_TTL_SECONDS=3600
# AGORA_APP_CERTIFICATE is a SERVER SECRET -- set it in the CI/CD provider's
# secrets panel, not committed here. Until it is set, /platform/api/rtc/token
# correctly returns 503 instead of a fake token.
